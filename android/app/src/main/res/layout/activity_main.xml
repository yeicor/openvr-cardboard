<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <dev.openvrcardboard.phone.StereoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <dev.openvrcardboard.phone.VideoSurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#DD11151B"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/headsetModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/mode_headset"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/webcamModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_webcam"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <EditText
            android:id="@+id/hostField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/host_hint"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF" />

        <LinearLayout
            android:id="@+id/headsetFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/imuPortField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="IMU port"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" />

            <EditText
                android:id="@+id/videoPortField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Video port"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" />

            <EditText
                android:id="@+id/sensorHzField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Sensor Hz"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" />
        </LinearLayout>

        <EditText
            android:id="@+id/cameraPortField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/camera_port_hint"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF"
            android:visibility="gone" />

        <EditText
            android:id="@+id/tokenField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/token_hint"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/stop" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9FE3A5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/help"
            android:textColor="#AAB4C0"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
